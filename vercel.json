{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": { "deploymentEnabled": { "release/ims-unified-2026-09": false } },
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "functions": { "app/api/generate/route.ts": { "maxDuration": 60 } },
  "crons": [
    { "path": "/api/cron/low-balance", "schedule": "0 15 * * *" },
    { "path": "/api/cron/recurring", "schedule": "0 14 * * *" },
    { "path": "/api/cron/session-reminders", "schedule": "0 16 * * *" }
  ]
}
